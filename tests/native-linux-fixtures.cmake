enable_testing()
add_executable(linux_copy_tests ../tests/native-copy-linux.test.cc)
add_executable(linux_clipboard_format_tests ../tests/native-clipboard-linux-formats.test.cc src/clipboard-linux-formats.cc)
add_executable(linux_clipboard_x11_tests ../tests/native-clipboard-linux-x11.test.cc src/clipboard-linux.cc src/clipboard-linux-formats.cc)
find_library(XCB_TEST_LIBRARY NAMES libxcb.so.1 HINTS "${CLIPBOARD_LINUX_SDK_ROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}" REQUIRED)
add_executable(linux_clipboard_x11_protocol_tests ../tests/native-clipboard-x11-protocol.test.cc)
target_compile_features(linux_clipboard_x11_protocol_tests PRIVATE cxx_std_17)
target_compile_options(linux_clipboard_x11_protocol_tests PRIVATE -Wall -Wextra -Werror)
target_include_directories(linux_clipboard_x11_protocol_tests PRIVATE "${XCB_INCLUDE_DIR}")
target_link_libraries(linux_clipboard_x11_protocol_tests PRIVATE "${XCB_TEST_LIBRARY}" Threads::Threads)
add_executable(linux_clipboard_wayland_tests ../tests/native-clipboard-wayland.test.cc src/clipboard-wayland-linux.cc src/clipboard-linux-formats.cc)
find_program(WAYLAND_SCANNER_EXECUTABLE wayland-scanner HINTS "${CLIPBOARD_LINUX_SDK_ROOT}/usr/bin" REQUIRED)
set(EXT_DATA_CONTROL_PROTOCOL "${CMAKE_CURRENT_SOURCE_DIR}/src/protocols/ext-data-control-v1.xml")
file(READ "${EXT_DATA_CONTROL_PROTOCOL}" EXT_DATA_CONTROL_CONTENT)
string(REPLACE "\r\n" "\n" EXT_DATA_CONTROL_CONTENT "${EXT_DATA_CONTROL_CONTENT}")
string(SHA256 EXT_DATA_CONTROL_SHA256 "${EXT_DATA_CONTROL_CONTENT}")
if(NOT EXT_DATA_CONTROL_SHA256 STREQUAL "293deba5dfdb974fbcf8dcf891a30a51a36a8bba0047dc6bdf6a03194089b7fb")
  message(FATAL_ERROR "The data-control protocol definition does not match the verified contract.")
endif()
find_library(WAYLAND_SERVER_LIBRARY NAMES wayland-server libwayland-server.so.0 HINTS "${CLIPBOARD_LINUX_SDK_ROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}" REQUIRED)
set(WAYLAND_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/wayland")
file(MAKE_DIRECTORY "${WAYLAND_GENERATED_DIR}")
add_custom_command(OUTPUT "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-server-protocol.h" "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-protocol.c"
  COMMAND "${WAYLAND_SCANNER_EXECUTABLE}" server-header "${EXT_DATA_CONTROL_PROTOCOL}" "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-server-protocol.h"
  COMMAND "${WAYLAND_SCANNER_EXECUTABLE}" private-code "${EXT_DATA_CONTROL_PROTOCOL}" "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-protocol.c"
  DEPENDS "${EXT_DATA_CONTROL_PROTOCOL}" VERBATIM)
add_executable(linux_clipboard_wayland_protocol_tests ../tests/native-clipboard-wayland-protocol.test.cc src/clipboard-wayland-linux.cc src/clipboard-linux-formats.cc
  "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-server-protocol.h" "${WAYLAND_GENERATED_DIR}/ext-data-control-v1-protocol.c")
target_include_directories(linux_clipboard_wayland_protocol_tests PRIVATE "${WAYLAND_GENERATED_DIR}")
target_compile_features(linux_clipboard_wayland_protocol_tests PRIVATE c_std_99)
target_link_libraries(linux_clipboard_wayland_protocol_tests PRIVATE "${WAYLAND_SERVER_LIBRARY}")
foreach(fixture linux_copy_tests linux_clipboard_format_tests linux_clipboard_x11_tests linux_clipboard_wayland_tests linux_clipboard_wayland_protocol_tests)
  target_compile_features(${fixture} PRIVATE cxx_std_17)
  target_compile_options(${fixture} PRIVATE -Wall -Wextra -Werror)
  target_include_directories(${fixture} PRIVATE "${XCB_INCLUDE_DIR}" "${XCB_XFIXES_INCLUDE_DIR}" "${WAYLAND_CLIENT_INCLUDE_DIR}")
  target_link_libraries(${fixture} PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
  add_test(NAME ${fixture} COMMAND ${fixture})
  set_tests_properties(${fixture} PROPERTIES TIMEOUT 30)
endforeach()
